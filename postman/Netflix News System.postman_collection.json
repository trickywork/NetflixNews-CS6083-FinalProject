{
  "info": {
    "name": "Netflix News System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin_1\",\n  \"password\": \"123456\"\n}"
        },
        "url": "{{base_url}}/api/auth/login"
      }
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{base_url}}/api/auth/me"
      }
    },
    {
      "name": "Dashboard Statistics",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/statistics/dashboard"
      }
    },
    {
      "name": "Web Series",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/web-series"
      }
    },
    {
      "name": "Search Web Series",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/web-series/search?keyword=drama"
      }
    },
    {
      "name": "Schedules",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/schedules"
      }
    },
    {
      "name": "Feedback",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/feedback"
      }
    },
    {
      "name": "Production Houses",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/production-houses"
      }
    },
    {
      "name": "Producers",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/producers"
      }
    },
    {
      "name": "Contracts",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/contracts"
      }
    }
  ]
}
